__PEPPY_HOSTS__ {
	header Strict-Transport-Security "max-age=15552000"

	request_body {
		max_size {$MAX_UPLOAD_BYTES:64MB}
	}

	reverse_proxy api:8080 {
		header_up Host {http.request.host}
		header_up X-Forwarded-Proto https
		transport http {
			dial_timeout 5s
			response_header_timeout 30s
		}
		stream_timeout 24h
	}
}
