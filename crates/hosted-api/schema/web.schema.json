    "CiphertextV1": {
      "additionalProperties": false,
      "properties": {
        "algorithm": {
          "const": "aes-256-gcm",
          "type": "string"
        },
        "ciphertext": {
          "type": "string"
        },
        "keyId": {
          "type": "string"
        },
        "nonce": {
          "type": "string"
        },
        "version": {
          "const": 1,
          "type": "integer"
