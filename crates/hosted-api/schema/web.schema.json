        "retire_legacy_accounts": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "expected_revision",
        "kdf",
        "check",
        "entries",
        "legacy_mappings",
        "retire_legacy_accounts",
        "confirm_legacy_retirement"
      ],
      "type": "object"
    },
    "InitializeTestersRequestV2": {
      "additionalProperties": false,
      "properties": {
        "binding": {
          "$ref": "#/$defs/VaultBindingV2"
        },
        "confirm_legacy_retirement": {
          "type": "boolean"
