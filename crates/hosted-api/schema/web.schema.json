{
  "$defs": {
    "BillingOperationRequest": {
      "additionalProperties": false,
      "properties": {
        "operation_id": {
          "format": "uuid",
          "type": "string"
        }
      },
      "required": [
        "operation_id"
      ],
      "type": "object"
    },
    "BillingPlans": {
      "additionalProperties": false,
      "properties": {
        "default_price_id": {
          "type": "string"
        },
        "plans": {
          "items": {
            "$ref": "#/$defs/PlanSummary"
          },
          "type": "array"
        }
      },
      "required": [
        "default_price_id",
        "plans"
      ],
      "type": "object"
    },
    "BillingSummary": {
      "additionalProperties": false,
      "properties": {
        "access": {
          "type": "string"
        },
        "cancel_at_period_end": {
          "type": "boolean"
        },
        "invoices": {
          "items": {
            "$ref": "#/$defs/InvoiceSummary"
          },
          "type": "array"
        },
        "paid_through": {
          "format": "int64",
          "type": "integer"
        },
        "plan": {
          "$ref": "#/$defs/PlanSummary"
        },
        "price_id": {
          "type": "string"
        },
        "subscription_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "subscription_status": {
          "type": "string"
        }
      },
      "required": [
        "subscription_status",
        "paid_through",
        "cancel_at_period_end",
        "access",
        "price_id",
        "plan",
        "invoices"
      ],
      "type": "object"
    },
    "DeletionState": {
      "enum": [
        "none",
        "pending"
      ],
      "type": "string"
    },
    "IdentityProvider": {
      "description": "Identity provider for authentication.",
      "enum": [
        "apple",
        "google"
      ],
      "type": "string"
    },
    "InvoiceSummary": {
      "additionalProperties": false,
      "properties": {
        "amount_due": {
          "format": "int64",
          "type": "integer"
        },
        "amount_paid": {
          "format": "int64",
          "type": "integer"
        },
        "created_at": {
          "format": "int64",
          "type": "integer"
        },
        "currency": {
          "type": "string"
        },
        "hosted_invoice_url": {
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "type": "string"
        },
        "status": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "status",
        "amount_due",
        "amount_paid",
        "currency",
        "created_at"
      ],
      "type": "object"
    },
    "PaymentMethodConfirmRequest": {
      "additionalProperties": false,
      "properties": {
        "operation_id": {
          "format": "uuid",
          "type": "string"
        },
        "setup_intent_id": {
          "type": "string"
        }
      },
      "required": [
        "operation_id",
        "setup_intent_id"
      ],
      "type": "object"
    },
    "PaymentMethodSetupResponse": {
      "additionalProperties": false,
      "properties": {
        "client_secret": {
          "type": "string"
        },
        "setup_intent_id": {
          "type": "string"
        }
      },
      "required": [
        "setup_intent_id",
        "client_secret"
      ],
      "type": "object"
    },
    "PlanSummary": {
      "additionalProperties": false,
      "properties": {
        "comped": {
          "type": "boolean"
        },
        "currency": {
          "type": "string"
        },
        "discount_percent": {
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "interval": {
          "type": "string"
        },
        "interval_count": {
          "format": "int64",
          "type": "integer"
        },
        "price_id": {
          "type": "string"
        },
        "product_name": {
          "type": "string"
        },
        "unit_amount": {
          "format": "int64",
          "type": "integer"
        }
      },
      "required": [
        "price_id",
        "product_name",
        "unit_amount",
        "currency",
        "interval",
        "interval_count",
        "comped"
      ],
      "type": "object"
    },
    "SubscribeRequest": {
      "additionalProperties": false,
      "properties": {
        "expected_price_id": {
          "description": "The selected, configured quote; stale or unconfigured quotes are rejected.",
          "type": "string"
        },
        "operation_id": {
          "format": "uuid",
          "type": "string"
        }
      },
      "required": [
        "operation_id",
        "expected_price_id"
      ],
      "type": "object"
    },
    "SubscribeResponse": {
      "additionalProperties": false,
      "properties": {
        "next_action": {
          "$ref": "#/$defs/SubscriptionAction"
        },
        "subscription_id": {
          "type": "string"
        }
      },
      "required": [
        "subscription_id",
        "next_action"
      ],
      "type": "object"
    },
    "SubscriptionAction": {
      "oneOf": [
        {
          "properties": {
            "client_secret": {
              "type": "string"
            },
            "kind": {
              "const": "payment",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "client_secret"
          ],
          "type": "object"
        },
        {
          "properties": {
            "client_secret": {
              "type": "string"
            },
            "kind": {
              "const": "setup",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "client_secret"
          ],
          "type": "object"
        },
        {
          "properties": {
            "kind": {
              "const": "none",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        }
      ]
    },
    "WebAccountResponse": {
      "additionalProperties": false,
      "properties": {
        "account_id": {
          "format": "uuid",
          "type": "string"
        },
        "deletion_state": {
          "$ref": "#/$defs/DeletionState"
        }
      },
      "required": [
        "account_id",
        "deletion_state"
      ],
      "type": "object"
    },
    "WebConfigResponse": {
      "additionalProperties": false,
      "properties": {
        "available_providers": {
          "items": {
            "$ref": "#/$defs/IdentityProvider"
          },
          "type": "array"
        },
        "stripe_publishable_key": {
          "type": "string"
        }
      },
      "required": [
        "stripe_publishable_key",
        "available_providers"
      ],
      "type": "object"
    },
    "WebSessionResponse": {
      "additionalProperties": false,
      "properties": {
        "account_id": {
          "format": "uuid",
          "type": [
            "string",
            "null"
          ]
        },
        "authenticated": {
          "type": "boolean"
        },
        "csrf_token": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "authenticated"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "account": {
      "$ref": "#/$defs/WebAccountResponse"
    },
    "billing": {
      "$ref": "#/$defs/BillingSummary"
    },
    "config": {
      "$ref": "#/$defs/WebConfigResponse"
    },
    "operation": {
      "$ref": "#/$defs/BillingOperationRequest"
    },
    "payment_method_confirm": {
      "$ref": "#/$defs/PaymentMethodConfirmRequest"
    },
    "payment_method_setup": {
      "$ref": "#/$defs/PaymentMethodSetupResponse"
    },
    "plan_catalog": {
      "$ref": "#/$defs/BillingPlans"
    },
    "session": {
      "$ref": "#/$defs/WebSessionResponse"
    },
    "subscribe_request": {
      "$ref": "#/$defs/SubscribeRequest"
    },
    "subscribe_response": {
      "$ref": "#/$defs/SubscribeResponse"
    }
  },
  "required": [
    "session",
    "config",
    "account",
    "billing",
    "plan_catalog",
    "operation",
    "subscribe_request",
    "subscribe_response",
    "payment_method_confirm",
    "payment_method_setup"
  ],
  "title": "HostedWebContracts",
  "type": "object",
  "x-peppy-routes": {
    "account": "/hosted/v1/web/account",
    "authStart": "/hosted/v1/web/auth/{provider}/start",
    "billing": "/hosted/v1/web/billing",
    "cancel": "/hosted/v1/web/billing/cancel",
    "config": "/hosted/v1/web/config",
    "invoices": "/hosted/v1/web/billing/invoices",
    "logout": "/hosted/v1/web/logout",
    "paymentAction": "/hosted/v1/web/billing/payment-action",
    "paymentMethod": "/hosted/v1/web/billing/payment-method",
    "paymentMethodConfirm": "/hosted/v1/web/billing/payment-method/confirm",
    "plans": "/hosted/v1/web/billing/plans",
    "reconcile": "/hosted/v1/web/billing/reconcile",
    "resume": "/hosted/v1/web/billing/resume",
    "session": "/hosted/v1/web/session",
    "subscribe": "/hosted/v1/web/billing/subscribe"
  }
}
