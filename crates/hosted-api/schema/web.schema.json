      "additionalProperties": false,
      "properties": {
        "algorithm": {
          "const": "xchacha20poly1305-ietf",
          "type": "string"
        },
        "ciphertext": {
          "type": "string"
        },
        "keyId": {
          "format": "uuid",
          "type": "string"
        },
        "nonce": {
          "type": "string"
        },
        "version": {
          "const": 2,
          "type": "integer"
        }
      },
      "required": [
        "version",
        "algorithm",
        "keyId",
        "nonce",
        "ciphertext"
      ],
      "type": "object"
    },
    "DeletionState": {
      "enum": [
        "none",
        "pending"
      ],
      "type": "string"
    },
    "EncryptedEnvelopeV2": {
      "additionalProperties": false,
      "properties": {
        "ciphertext": {
          "items": {
            "format": "uint8",
            "maximum": 255,
            "minimum": 0,
            "type": "integer"
          },
          "type": "array"
        },
        "nonce": {
          "items": {
            "format": "uint8",
            "maximum": 255,
            "minimum": 0,
            "type": "integer"
          },
          "maxItems": 24,
          "minItems": 24,
          "type": "array"
        }
      },
      "required": [
        "nonce",
        "ciphertext"
      ],
      "type": "object"
    },
    "IdentityProvider": {
      "description": "Identity provider for authentication.",
      "enum": [
        "apple",
        "google"
      ],
      "type": "string"
    },
    "InitializeTestersRequest": {
      "additionalProperties": false,
      "properties": {
        "check": {
          "$ref": "#/$defs/CiphertextV1"
        },
        "confirm_legacy_retirement": {
          "type": "boolean"
        },
        "entries": {
          "items": {
            "$ref": "#/$defs/TesterInput"
          },
          "type": "array"
        },
        "expected_revision": {
          "type": "string"
        },
        "kdf": {
          "$ref": "#/$defs/KdfV1"
        },
        "legacy_mappings": {
          "items": {
            "$ref": "#/$defs/LegacyTesterMapping"
