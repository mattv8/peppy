{
  "constants": { "overheadBytes": 16384, "minImageBudgetBytes": 92160, "maxAttachments": 10 },
  "vectors": [
    { "name": "fits as-is", "limit": 307200, "version": 4, "text": "See you soon", "images": [{ "bytes": 100000, "type": "image/jpeg" }, { "bytes": 100000, "type": "image/png" }], "expect": { "kind": "single", "parts": 1 } },
    { "name": "old gateway over limit", "limit": 307200, "version": 3, "text": "", "images": [{ "bytes": 200000, "type": "image/jpeg" }, { "bytes": 200000, "type": "image/jpeg" }], "expect": { "kind": "error" } },
    { "name": "old gateway fits", "limit": 307200, "version": 3, "text": "Hi", "images": [{ "bytes": 100000, "type": "image/jpeg" }], "expect": { "kind": "single", "parts": 1 } },
    { "name": "three large photos resize into one message", "limit": 307200, "version": 4, "text": "Photos from Saturday", "images": [{ "bytes": 3000000, "type": "image/jpeg" }, { "bytes": 2800000, "type": "image/jpeg" }, { "bytes": 3400000, "type": "image/heic" }], "expect": { "kind": "single", "parts": 1 } },
    { "name": "four photos split with caption", "limit": 307200, "version": 4, "text": "Photos from Saturday", "images": [{ "bytes": 3000000, "type": "image/jpeg" }, { "bytes": 3000000, "type": "image/jpeg" }, { "bytes": 3000000, "type": "image/jpeg" }, { "bytes": 3000000, "type": "image/jpeg" }], "expect": { "kind": "split", "caption": true, "groups": [2, 2], "parts": 3 } },
    { "name": "four photos split without caption", "limit": 307200, "version": 4, "text": "   ", "images": [{ "bytes": 3000000, "type": "image/jpeg" }, { "bytes": 3000000, "type": "image/jpeg" }, { "bytes": 3000000, "type": "image/jpeg" }, { "bytes": 3000000, "type": "image/jpeg" }], "expect": { "kind": "split", "caption": false, "groups": [2, 2], "parts": 2 } },
    { "name": "seven photos balanced groups", "limit": 307200, "version": 4, "text": "Trip", "images": [{ "bytes": 2000000, "type": "image/jpeg" }, { "bytes": 2000000, "type": "image/jpeg" }, { "bytes": 2000000, "type": "image/jpeg" }, { "bytes": 2000000, "type": "image/jpeg" }, { "bytes": 2000000, "type": "image/jpeg" }, { "bytes": 2000000, "type": "image/jpeg" }, { "bytes": 2000000, "type": "image/jpeg" }], "expect": { "kind": "split", "caption": true, "groups": [3, 2, 2], "parts": 4 } },
    { "name": "large carrier limit keeps ten photos together", "limit": 1048576, "version": 4, "text": "All of them", "images": [{ "bytes": 2000000, "type": "image/jpeg" }, { "bytes": 2000000, "type": "image/jpeg" }, { "bytes": 2000000, "type": "image/jpeg" }, { "bytes": 2000000, "type": "image/jpeg" }, { "bytes": 2000000, "type": "image/jpeg" }, { "bytes": 2000000, "type": "image/jpeg" }, { "bytes": 2000000, "type": "image/jpeg" }, { "bytes": 2000000, "type": "image/jpeg" }, { "bytes": 2000000, "type": "image/jpeg" }, { "bytes": 2000000, "type": "image/jpeg" }], "expect": { "kind": "single", "parts": 1 } },
    { "name": "tiny carrier limit sends one photo per message", "limit": 102400, "version": 4, "text": "Look", "images": [{ "bytes": 500000, "type": "image/jpeg" }, { "bytes": 500000, "type": "image/jpeg" }, { "bytes": 500000, "type": "image/webp" }], "expect": { "kind": "split", "caption": true, "groups": [1, 1, 1], "parts": 4 } },
    { "name": "large animated gif cannot shrink", "limit": 307200, "version": 4, "text": "", "images": [{ "bytes": 400000, "type": "image/gif" }], "expect": { "kind": "error" } },
    { "name": "small gif rides along with resizable photos", "limit": 307200, "version": 4, "text": "", "images": [{ "bytes": 60000, "type": "image/gif" }, { "bytes": 3000000, "type": "image/jpeg" }], "expect": { "kind": "single", "parts": 1 } },
    { "name": "medium gif with photos over limit", "limit": 307200, "version": 4, "text": "", "images": [{ "bytes": 150000, "type": "image/gif" }, { "bytes": 3000000, "type": "image/jpeg" }], "expect": { "kind": "error" } }
  ]
}
