{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Peppy desktop main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:event:default",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-start-dragging",
    "allow-load-state",
    "allow-load-history",
    "allow-search-local",
    "allow-advance-search-index",
    "allow-load-message-window",
    "allow-open-external-url",
    "allow-configure-server",
    "allow-unlock-sync",
    "allow-get-app-lock-status",
    "allow-unlock-app",
    "allow-set-app-lock",
    "allow-save-draft",
    "allow-discard-draft",
    "allow-send-draft",
    "allow-mark-seen",
    "allow-mark-all-read",
    "allow-pick-attachments",
    "allow-retry-attachment",
    "allow-save-attachment",
    "allow-request-attachment-download",
    "allow-media-sync-request",
    "allow-media-page",
    "allow-media-page-around",
    "allow-media-page-newer",
    "allow-open-media",
    "allow-load-media",
    "allow-close-media",
    "allow-publish-attachment",
    "allow-open-composer",
    "allow-dismiss-notification",
    "allow-dismiss-all-notifications",
    "allow-set-app-muted",
    "allow-mark-notifications-seen",
    "allow-set-notification-preferences",
    "allow-set-notification-context",
    "allow-request-notification-permission",
    "allow-list-contact-books",
    "allow-list-contacts",
    "allow-forget-contact-book",
    "allow-submit-contact-edit",
    "allow-list-contact-edits",
    "allow-pick-contact-photo",
    "allow-search-contact-recipients",
    "allow-request-contact-repair",
    "allow-request-contact-sync",
    "allow-get-contact-sync-request",
    "allow-list-restorable-contacts",
    "allow-restore-contact",
    "allow-list-devices",
    "allow-revoke-device",
    "allow-set-start-at-login",
    "allow-hide-head",
    "allow-popout-conversation",
    "allow-acknowledge-lifecycle",
    "allow-hosted-account",
    "allow-hosted-session-renew",
    "allow-hosted-origin-url",
    "allow-hosted-sign-in",
    "allow-hosted-sign-out",
    "allow-hosted-open-billing",
    "allow-hosted-provision",
    "allow-enrollment-discover",
    "allow-enrollment-start-over",
    "allow-enrollment-create-owner",
    "allow-enrollment-sign-in",
    "allow-enrollment-connect-shared-secret",
    "allow-enrollment-begin-vault-request",
    "allow-enrollment-vault-request-status",
    "allow-enrollment-create-vault",
    "allow-enrollment-add-phone",
    "allow-enrollment-rotate-phone",
    "allow-enrollment-cancel-phone",
    "allow-reveal-vault-secret",
    "allow-enrollment-approve",
    "allow-enrollment-status",
    "allow-enrollment-cancel",
    "allow-enrollment-sign-out",
    "allow-update-status",
    "allow-check-for-updates",
    "allow-restart-for-update",
    "allow-defer-update",
    "allow-set-automatic-updates",
    "allow-report-update-activity",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://peppy.pro/privacy"
        }
      ]
    }
  ]
