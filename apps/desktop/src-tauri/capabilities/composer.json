{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "composer",
  "description": "Peppy frameless composer windows",
  "windows": [
    "composer-*"
  ],
  "permissions": [
    "core:event:default",
    "core:window:allow-close",
    "core:window:allow-start-dragging",
    "allow-load-state",
    "allow-load-history",
    "allow-open-external-url",
    "allow-save-draft",
    "allow-send-draft",
    "allow-mark-seen",
    "allow-pick-attachments",
    "allow-retry-attachment",
    "allow-save-attachment",
    "allow-request-attachment-download",
    "allow-media-page",
    "allow-media-page-around",
    "allow-media-page-newer",
    "allow-open-media",
    "allow-load-media",
    "allow-close-media",
    "allow-close-composer",
    "allow-close-head-panel",
    "allow-search-contact-recipients",
    "allow-acknowledge-lifecycle",
    "allow-report-update-activity"
  ]
}
