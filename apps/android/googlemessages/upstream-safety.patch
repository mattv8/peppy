+func publishSafetyAuth(auth *AuthData, token string, ttl int64) {
+	auth.stateLock.Lock()
+	defer auth.stateLock.Unlock()
+	auth.TachyonAuthToken, auth.TachyonTTL = []byte(token), ttl
+	auth.Browser, auth.Mobile = &gmproto.Device{SourceID: token}, &gmproto.Device{SourceID: token}
+}
