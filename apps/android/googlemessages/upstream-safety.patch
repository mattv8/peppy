+func assertBuiltAuthGeneration(t *testing.T, h *SessionHandler, params SendMessageParams) {
+	t.Helper()
+	_, raw, err := h.buildMessage(params)
+	if err != nil {
+		t.Fatal(err)
+	}
+	message := raw.(*gmproto.OutgoingRPCMessage)
+	token := string(message.GetAuth().GetTachyonAuthToken())
+	if message.GetMobile().GetSourceID() != token {
+		t.Fatalf("mixed token/mobile generation")
+	}
+	if params.CustomTTL != 0 {
+		if message.GetTTL() != params.CustomTTL {
+			t.Fatalf("custom TTL = %d", message.GetTTL())
+		}
+		return
+	}
+	if params.OmitTTL {
+		if message.GetTTL() != 0 {
+			t.Fatalf("omitted TTL = %d", message.GetTTL())
+		}
+		return
+	}
+	want := map[string]int64{"token-a": 101, "token-b": 202}[token]
+	if message.GetTTL() != want {
+		t.Fatalf("token %q with TTL %d, want %d", token, message.GetTTL(), want)
+	}
+}
