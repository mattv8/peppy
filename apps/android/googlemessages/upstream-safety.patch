+type safetyBlockingPollBody struct {
+	firstRead atomic.Bool
+	closed    chan struct{}
+	closeOnce sync.Once
+}
+
+func newSafetyBlockingPollBody() *safetyBlockingPollBody {
+	return &safetyBlockingPollBody{closed: make(chan struct{})}
+}
+
+func (body *safetyBlockingPollBody) Read(buffer []byte) (int, error) {
+	if body.firstRead.CompareAndSwap(false, true) {
+		return copy(buffer, "[["), nil
+	}
+	<-body.closed
+	return 0, io.EOF
+}
+
+func (body *safetyBlockingPollBody) Close() error {
+	body.closeOnce.Do(func() { close(body.closed) })
+	return nil
+}
