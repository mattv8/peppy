+package libgm
+
+// StreamSource identifies one physical HTTP long-poll response body.
+type StreamSource struct {
+	ListenID    int64
+	PollAttempt int64
+}
+
+type StreamOpened struct{ Source StreamSource }
+type StreamRetired struct{ Source StreamSource }
+type ContinuityLost struct {
+	Source StreamSource
+	Reason string
+}
+type StreamEvent struct {
+	Source StreamSource
+	Event  any
+}
+
+func (c *Client) triggerStreamEvent(source StreamSource, event any) {
+	c.triggerEvent(&StreamEvent{Source: source, Event: event})
+}
