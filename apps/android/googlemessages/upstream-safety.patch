+func TestRPCBuildersUseConsistentAuthGenerationDuringRefresh(t *testing.T) {
+	auth := linkedSafetyAuth()
+	publishSafetyAuth(auth, "token-a", 101)
+	mismatches := make(chan error, 1)
+	client := newSafetyClient(auth, func(request *http.Request) (*http.Response, error) {
+		body, err := io.ReadAll(request.Body)
+		if err != nil {
+			return nil, err
+		}
+		var payload gmproto.AckMessageRequest
+		if err = pblite.Unmarshal(body, &payload); err != nil {
+			return nil, err
+		}
+		token := string(payload.GetAuthData().GetTachyonAuthToken())
+		if len(payload.GetAcks()) != 1 || payload.GetAcks()[0].GetDevice().GetSourceID() != token {
+			select {
+			case mismatches <- fmt.Errorf("mixed ack auth generation"):
+			default:
+			}
+		}
+		return successfulProtoResponse(request)
+	})
+	stop, firstPublished := make(chan struct{}), make(chan struct{})
+	go func() {
+		for i := 0; ; i++ {
+			select {
+			case <-stop:
+				return
+			default:
+			}
+			if i%2 == 0 {
+				publishSafetyAuth(auth, "token-b", 202)
+			} else {
+				publishSafetyAuth(auth, "token-a", 101)
+			}
+			if i == 0 {
+				close(firstPublished)
+			}
+		}
+	}()
+	awaitSafetySignal(t, firstPublished, "concurrent auth refresh")
+	for i := 0; i < 300; i++ {
+		assertBuiltAuthGeneration(t, client.sessionHandler, SendMessageParams{})
+		assertBuiltAuthGeneration(t, client.sessionHandler, SendMessageParams{OmitTTL: true})
+		assertBuiltAuthGeneration(t, client.sessionHandler, SendMessageParams{CustomTTL: 777})
+		client.sessionHandler.queueMessageAck(fmt.Sprintf("ack-%d", i))
+		client.sessionHandler.sendAckRequest(context.Background())
+	}
+	close(stop)
+	select {
+	case err := <-mismatches:
+		t.Fatal(err)
+	default:
+	}
+}
