+func TestPostConnectCancellationAtEveryDelay(t *testing.T) {
+	cases := []struct {
+		name           string
+		cancelAt, skip int
+		want           int64
+	}{
+		{"initial", 1, 0, 0}, {"skip-one", 2, 1, 0}, {"skip-two", 3, 1, 0}, {"skip-three", 4, 1, 0}, {"after-ack", 5, 1, 1},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			var requests atomic.Int64
+			client := newSafetyClient(linkedSafetyAuth(), func(request *http.Request) (*http.Response, error) {
+				requests.Add(1)
+				return successfulProtoResponse(request)
+			})
+			client.skipCount = tc.skip
+			if tc.want > 0 {
+				client.sessionHandler.queueMessageAck("synthetic-ack")
+			}
+			ctx, cancel := context.WithCancel(context.Background())
+			waits := 0
+			client.postConnectWait = func(context.Context, time.Duration) bool {
+				waits++
+				if waits == tc.cancelAt {
+					cancel()
+					return false
+				}
+				return true
+			}
+			client.postConnect(ctx, nil)
+			if got := requests.Load(); got != tc.want {
+				t.Fatalf("requests = %d, want %d", got, tc.want)
+			}
+		})
+	}
+}
