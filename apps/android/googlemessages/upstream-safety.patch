+func (c *Client) openStream(source StreamSource) bool {
+	c.listenLock.Lock()
+	defer c.listenLock.Unlock()
+	if c.listenID.Load() != source.ListenID {
+		return false
+	}
+	c.currentSource = source
+	c.triggerEvent(&StreamOpened{Source: source})
+	return true
+}
+
+func (c *Client) retireStream(source StreamSource) bool {
+	c.listenLock.Lock()
+	defer c.listenLock.Unlock()
+	return c.retireStreamLocked(source)
+}
+
+func (c *Client) retireStreamLocked(source StreamSource) bool {
+	if c.currentSource != source || source == (StreamSource{}) {
+		return false
+	}
+	c.triggerEvent(&StreamRetired{Source: source})
+	c.currentSource = StreamSource{}
+	return true
+}
+
+func (c *Client) continuityLost(source StreamSource, reason string) bool {
+	c.listenLock.Lock()
+	defer c.listenLock.Unlock()
+	if c.currentSource != source || source == (StreamSource{}) {
+		return false
+	}
+	c.triggerEvent(&ContinuityLost{Source: source, Reason: reason})
+	return true
+}
+
+func (c *Client) emitStreamGapFor(listenID int64) bool {
+	c.listenLock.Lock()
+	defer c.listenLock.Unlock()
+	if c.currentSource.ListenID != listenID {
+		return false
+	}
+	return c.retireStreamLocked(c.currentSource)
+}
