+func TestReentrantReconnectKeepsReplacementStreamInstalled(t *testing.T) {
+	auth := linkedSafetyAuth()
+	auth.stateLock.Lock()
+	auth.TachyonExpiry = time.Now().Add(2 * time.Hour)
+	auth.stateLock.Unlock()
+	replacementBody := newSafetyBlockingPollBody()
+	client := newSafetyClient(auth, func(request *http.Request) (*http.Response, error) {
+		return &http.Response{
+			StatusCode: http.StatusOK,
+			Header:     make(http.Header),
+			Body:       replacementBody,
+			Request:    request,
+		}, nil
+	})
+	client.listenID.Store(60)
+	retiredSource := StreamSource{ListenID: 60, PollAttempt: 1}
+	client.currentSource = retiredSource
+	retiredBody := io.ReadCloser(io.NopCloser(strings.NewReader("")))
+	client.longPollingConn.Store(&retiredBody)
+
+	replacementPublished := make(chan struct{})
+	var publishOnce sync.Once
+	var installedSource StreamSource
+	var installedBody *io.ReadCloser
+	client.SetEventHandler(func(event any) {
+		retired, ok := event.(*StreamRetired)
+		if !ok || retired.Source != retiredSource {
+			return
+		}
+		client.afterStreamPublication = func(StreamSource) {
+			publishOnce.Do(func() { close(replacementPublished) })
+		}
+		if err := client.Reconnect(context.Background()); err != nil {
+			t.Fatalf("reentrant reconnect failed: %v", err)
+		}
+		awaitSafetySignal(t, replacementPublished, "replacement stream publication")
+		client.listenLock.Lock()
+		installedSource = client.currentSource
+		installedBody = client.longPollingConn.Load()
+		client.listenLock.Unlock()
+	})
+
+	client.closeLongPolling()
+	client.listenLock.Lock()
+	currentSource := client.currentSource
+	currentBody := client.longPollingConn.Load()
+	currentListenID := client.listenID.Load()
+	client.listenLock.Unlock()
+	if installedSource == (StreamSource{}) || installedBody == nil {
+		t.Fatal("reentrant reconnect did not install a replacement")
+	}
+	if currentSource != installedSource || currentBody != installedBody || currentListenID != installedSource.ListenID {
+		t.Fatalf("outer teardown invalidated replacement: source=%+v body_same=%t listen_id=%d, want source=%+v", currentSource, currentBody == installedBody, currentListenID, installedSource)
+	}
+	client.afterStreamPublication = nil
+	client.Disconnect()
+}
