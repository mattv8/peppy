+type safetyRoundTripper func(*http.Request) (*http.Response, error)
+
+func (roundTrip safetyRoundTripper) RoundTrip(request *http.Request) (*http.Response, error) {
+	return roundTrip(request)
+}
+
+func newSafetyClient(auth *AuthData, roundTrip safetyRoundTripper) *Client {
+	settings := exhttp.ClientSettings{TransportOverride: func(exhttp.ClientSettings) http.RoundTripper { return roundTrip }}
+	return NewClient(auth, nil, zerolog.Nop(), settings)
+}
+
+func successfulProtoResponse(request *http.Request) (*http.Response, error) {
+	body, err := pblite.Marshal(&gmproto.OutgoingRPCResponse{})
+	if err != nil {
+		return nil, err
+	}
+	return &http.Response{StatusCode: http.StatusOK, Header: http.Header{"Content-Type": []string{ContentTypePBLite}}, Body: io.NopCloser(bytes.NewReader(body)), Request: request}, nil
+}
+
+func awaitSafetySignal(t *testing.T, signal <-chan struct{}, description string) {
+	t.Helper()
+	select {
+	case <-signal:
+	case <-time.After(5 * time.Second):
+		t.Fatalf("timed out waiting for %s", description)
+	}
+}
+
+func linkedSafetyAuth() *AuthData {
+	auth := NewAuthData()
+	auth.stateLock.Lock()
+	auth.TachyonAuthToken = []byte("synthetic-token")
+	auth.TachyonExpiry = time.Now().Add(time.Hour)
+	auth.TachyonTTL = 60
+	auth.Browser = &gmproto.Device{SourceID: "synthetic-browser"}
+	auth.Mobile = &gmproto.Device{SourceID: "synthetic-mobile"}
+	auth.stateLock.Unlock()
+	return auth
+}
