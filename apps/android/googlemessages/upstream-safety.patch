+)
+
+func outgoingSessionID(message proto.Message) (string, error) {
+	outgoing, ok := message.(*gmproto.OutgoingRPCMessage)
+	if !ok {
+		return "", fmt.Errorf("built message type = %T", message)
+	}
+	var data gmproto.OutgoingRPCData
+	if err := proto.Unmarshal(outgoing.GetData().GetMessageData(), &data); err != nil {
+		return "", err
+	}
+	return data.GetSessionID(), nil
+}
+
+func TestSessionIDConcurrentResetAndBuild(t *testing.T) {
+	client := newSafetyClient(linkedSafetyAuth(), successfulProtoResponse)
+	client.sessionHandler.ResetSessionID()
+	start := make(chan struct{})
+	var workers sync.WaitGroup
+	workers.Add(2)
+	go func() {
+		defer workers.Done()
+		<-start
+		for range 2000 {
+			client.sessionHandler.ResetSessionID()
+		}
+	}()
+	go func() {
+		defer workers.Done()
+		<-start
+		for range 2000 {
+			_, message, err := client.sessionHandler.buildMessage(SendMessageParams{})
+			if err != nil {
+				t.Error(err)
+				return
+			}
+			sessionID, err := outgoingSessionID(message)
+			if err != nil {
+				t.Error(err)
+				return
+			}
+			if _, err = uuid.Parse(sessionID); err != nil {
+				t.Errorf("built invalid session ID: %v", err)
+				return
+			}
+		}
+	}()
+	close(start)
+	workers.Wait()
+}
+
+func TestSetActiveSessionUsesOneSessionID(t *testing.T) {
+	const workerCount = 64
+	errors := make(chan error, workerCount)
+	client := newSafetyClient(linkedSafetyAuth(), func(request *http.Request) (*http.Response, error) {
+		body, err := io.ReadAll(request.Body)
+		if err != nil {
+			return nil, err
+		}
+		var outgoing gmproto.OutgoingRPCMessage
+		if err = pblite.Unmarshal(body, &outgoing); err != nil {
+			return nil, err
+		}
+		var data gmproto.OutgoingRPCData
+		if err = proto.Unmarshal(outgoing.GetData().GetMessageData(), &data); err != nil {
+			return nil, err
+		}
+		requestID := outgoing.GetData().GetRequestID()
+		if requestID != data.GetSessionID() {
+			select {
+			case errors <- fmt.Errorf("request ID %q used session ID %q", requestID, data.GetSessionID()):
+			default:
+			}
+		}
+		return successfulProtoResponse(request)
+	})
+	start := make(chan struct{})
+	var workers sync.WaitGroup
+	for range workerCount {
+		workers.Add(1)
+		go func() {
+			defer workers.Done()
+			<-start
+			if err := client.SetActiveSession(context.Background()); err != nil {
+				t.Error(err)
+			}
+		}()
+	}
+	close(start)
+	workers.Wait()
+	close(errors)
+	for err := range errors {
+		t.Error(err)
+	}
+}
