+	pinger.OnRespond(1, time.Millisecond, client.currentSource, reset)
+	if successes != 1 {
+		t.Fatalf("live ping successes = %d, want 1", successes)
+	}
+	retiredSource := client.currentSource
+	client.currentSource = StreamSource{ListenID: 44, PollAttempt: 3}
+	pinger.OnRespond(2, time.Millisecond, retiredSource, reset)
+	if successes != 1 {
+		t.Fatalf("retired source ping emitted success; total = %d", successes)
+	}
+	cancel()
+	pinger.OnRespond(3, time.Millisecond, client.currentSource, reset)
+	if successes != 1 {
+		t.Fatalf("cancelled poll ping emitted success; total = %d", successes)
+	}
