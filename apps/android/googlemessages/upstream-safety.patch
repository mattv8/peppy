diff -ruN a/pkg/libgm/event_handler_test.go b/pkg/libgm/event_handler_test.go
--- pkg/libgm/event_handler_test.go	1969-12-31 17:00:00
+++ pkg/libgm/event_handler_test.go	2026-11-05 16:40:33
@@ -0,0 +1,41 @@
+package libgm
+
+import (
+	"testing"
+
+	"github.com/rs/zerolog"
+	"go.mau.fi/util/exhttp"
+
+	"go.mau.fi/mautrix-gmessages/pkg/libgm/gmproto"
+)
+
+func TestHandleUpdatesEventWrapsSettingsProvenance(t *testing.T) {
+	settings := &gmproto.Settings{SIMCards: []*gmproto.SIMCard{{
+		SIMParticipant: &gmproto.SIMParticipant{ID: "synthetic-settings"},
+	}}}
+	client := NewClient(NewAuthData(), nil, zerolog.Nop(), exhttp.ClientSettings{})
+	var received any
+	client.SetEventHandler(func(event any) { received = event })
+
+	source := StreamSource{ListenID: 3, PollAttempt: 9}
+	client.handleUpdatesEvent(&IncomingRPCMessage{
+		Source:  source,
+		IsOld:   true,
+		Message: &gmproto.RPCMessageData{Action: gmproto.ActionType_GET_UPDATES},
+		DecryptedMessage: &gmproto.UpdateEvents{Event: &gmproto.UpdateEvents_SettingsEvent{
+			SettingsEvent: settings,
+		}},
+	})
+
+	streamEvent, ok := received.(*StreamEvent)
+	if !ok || streamEvent.Source != source {
+		t.Fatalf("stream event = %#v", received)
+	}
+	wrapped, ok := streamEvent.Event.(*WrappedSettings)
+	if !ok {
+		t.Fatalf("event type = %T", streamEvent.Event)
+	}
+	if wrapped.Settings != settings || !wrapped.IsOld {
+		t.Fatalf("settings provenance = %+v", wrapped)
+	}
+}
