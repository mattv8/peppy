--- pkg/libgm/stream_gap_test.go	1969-12-31 17:00:00
+++ pkg/libgm/stream_gap_test.go	2026-11-05 16:40:33
@@ -0,0 +1,80 @@
+package libgm
+
+import (
+	"context"
+	"io"
+	"net/http"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/rs/zerolog"
+	"go.mau.fi/util/exhttp"
+)
+
+func TestReconnectEmitsStreamGapBeforeAdvancingListenID(t *testing.T) {
+	client := NewClient(NewAuthData(), nil, zerolog.Nop(), exhttp.ClientSettings{})
+	client.listenID.Store(41)
+	source := StreamSource{ListenID: 41, PollAttempt: 2}
+	client.currentSource = source
+	var retiredAtListenID int64
+	client.SetEventHandler(func(event any) {
+		if retired, ok := event.(*StreamRetired); ok && retired.Source == source {
+			retiredAtListenID = client.listenID.Load()
+		}
+	})
+
+	if err := client.Reconnect(context.Background()); err == nil {
+		t.Fatal("Reconnect unexpectedly accepted unlinked auth")
+	}
+	if retiredAtListenID != 41 {
+		t.Fatalf("retirement observed at listen ID %d, want 41 before teardown advances it", retiredAtListenID)
+	}
+}
+
+func TestCleanReadReturnEmitsStreamGap(t *testing.T) {
+	client := NewClient(NewAuthData(), nil, zerolog.Nop(), exhttp.ClientSettings{})
+	client.listenID.Store(7)
+	client.currentSource = StreamSource{ListenID: 7, PollAttempt: 1}
+	if !client.emitStreamGapFor(7) {
+		t.Fatal("current stream did not emit a gap")
+	}
+	client.listenID.Store(8)
+	if client.emitStreamGapFor(7) {
+		t.Fatal("retired stream emitted a gap for its replacement")
+	}
+}
+
+type streamGapRoundTripper func(*http.Request) (*http.Response, error)
+
+func (roundTrip streamGapRoundTripper) RoundTrip(request *http.Request) (*http.Response, error) {
+	return roundTrip(request)
+}
+
+func TestCleanLongPollEOFEmitsStreamGap(t *testing.T) {
+	auth := NewAuthData()
+	auth.TachyonAuthToken = []byte("synthetic-token")
+	auth.TachyonExpiry = time.Now().Add(time.Hour)
+	settings := exhttp.ClientSettings{TransportOverride: func(exhttp.ClientSettings) http.RoundTripper {
+		return streamGapRoundTripper(func(request *http.Request) (*http.Response, error) {
+			return &http.Response{
+				StatusCode: http.StatusOK,
+				Header:     make(http.Header),
+				Body:       io.NopCloser(strings.NewReader("[[]]")),
+				Request:    request,
+			}, nil
+		})
+	}}
+	client := NewClient(auth, nil, zerolog.Nop(), settings)
+	var gaps int
+	client.SetEventHandler(func(event any) {
+		if _, ok := event.(*StreamRetired); ok {
+			gaps++
+		}
+	})
+
+	client.doLongPoll(context.Background(), true, true, nil)
+	if gaps != 1 {
+		t.Fatalf("clean EOF emitted %d gaps, want 1", gaps)
+	}
+}
