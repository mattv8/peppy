+func TestCancelledRetiredWorkerCannotInvalidateReplacement(t *testing.T) {
+	client := NewClient(NewAuthData(), nil, zerolog.Nop(), exhttp.ClientSettings{})
+	client.listenID.Store(12)
+	replacement := StreamSource{ListenID: 12, PollAttempt: 4}
+	client.currentSource = replacement
+	body := io.ReadCloser(io.NopCloser(strings.NewReader("")))
+	client.longPollingConn.Store(&body)
+	retiredCtx, cancel := context.WithCancel(context.Background())
+	cancel()
+	if !client.doLongPoll(retiredCtx, false, true, nil) {
+		t.Fatal("cancelled retired worker reported unclean exit")
+	}
+	if got := client.listenID.Load(); got != replacement.ListenID {
+		t.Fatalf("retired worker advanced listen ID to %d, want %d", got, replacement.ListenID)
+	}
+	if client.currentSource != replacement || client.longPollingConn.Load() != &body {
+		t.Fatal("retired worker invalidated installed replacement")
+	}
+}
