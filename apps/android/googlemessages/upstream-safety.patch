+func waitForResponseWaiter(client *Client) <-chan struct{} {
+	ready := make(chan struct{})
+	go func() {
+		for {
+			client.sessionHandler.responseWaitersLock.Lock()
+			readyNow := len(client.sessionHandler.responseWaiters) == 1
+			client.sessionHandler.responseWaitersLock.Unlock()
+			if readyNow {
+				close(ready)
+				return
+			}
+			time.Sleep(time.Millisecond)
+		}
+	}()
+	return ready
+}
+
+func (s *SessionHandler) currentWaiterID() string {
+	s.responseWaitersLock.Lock()
+	defer s.responseWaitersLock.Unlock()
+	for requestID := range s.responseWaiters {
+		return requestID
+	}
+	return ""
+}
+
+func mustRPCDiagnosticMessage(t *testing.T, client *Client, action gmproto.ActionType, sessionID string) []byte {
+	t.Helper()
+	plaintext, err := proto.Marshal(&gmproto.ListConversationsResponse{})
+	if err != nil {
+		t.Fatal(err)
+	}
+	encrypted, err := client.AuthData.RequestCrypto.Encrypt(plaintext)
+	if err != nil {
+		t.Fatal(err)
+	}
+	message, err := proto.Marshal(&gmproto.RPCMessageData{Action: action, SessionID: sessionID, EncryptedData: encrypted})
+	if err != nil {
+		t.Fatal(err)
+	}
+	return message
+}
+
+func equalRPCDiagnosticStages(got, want []RPCDiagnosticStage) bool {
+	if len(got) != len(want) {
+		return false
+	}
+	for index := range got {
+		if got[index] != want[index] {
+			return false
+		}
+	}
+	return true
+}
