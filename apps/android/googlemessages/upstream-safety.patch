+package libgm
+
+import (
+	"io"
+	"sync"
+	"testing"
+
+	"github.com/rs/zerolog"
+	"go.mau.fi/util/exhttp"
+	"go.mau.fi/util/pblite"
+	"google.golang.org/protobuf/proto"
+
+	"go.mau.fi/mautrix-gmessages/pkg/libgm/gmproto"
+)
+
+type chunkReadCloser struct {
+	chunks [][]byte
+	index  int
+}
+
+func (reader *chunkReadCloser) Read(buffer []byte) (int, error) {
+	if reader.index >= len(reader.chunks) {
+		return 0, io.EOF
+	}
+	chunk := reader.chunks[reader.index]
+	reader.index++
+	return copy(buffer, chunk), nil
+}
+
+func (*chunkReadCloser) Close() error { return nil }
+
+func streamChunks(t *testing.T, payload *gmproto.LongPollingPayload) io.ReadCloser {
+	t.Helper()
+	encoded, err := pblite.Marshal(payload)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return &chunkReadCloser{chunks: [][]byte{
+		[]byte("[["),
+		append([]byte(","), encoded...),
+		[]byte("]]"),
+	}}
+}
+
+func encryptedSettingsPayload(t *testing.T, auth *AuthData, id string) *gmproto.LongPollingPayload {
+	t.Helper()
+	settings := &gmproto.Settings{SIMCards: []*gmproto.SIMCard{{
+		SIMParticipant: &gmproto.SIMParticipant{ID: id},
+	}}}
+	updates, err := proto.Marshal(&gmproto.UpdateEvents{Event: &gmproto.UpdateEvents_SettingsEvent{
+		SettingsEvent: settings,
+	}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	encrypted, err := auth.RequestCrypto.Encrypt(updates)
+	if err != nil {
+		t.Fatal(err)
+	}
+	message, err := proto.Marshal(&gmproto.RPCMessageData{
+		Action:        gmproto.ActionType_GET_UPDATES,
+		EncryptedData: encrypted,
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	return &gmproto.LongPollingPayload{Data: &gmproto.IncomingRPCMessage{
+		ResponseID:  "synthetic-response",
+		BugleRoute:  gmproto.BugleRoute_DataEvent,
+		MessageData: message,
+	}}
+}
+
+func TestReaderPreservesOriginalSourceAcrossReplacement(t *testing.T) {
+	auth := NewAuthData()
+	client := NewClient(auth, nil, zerolog.Nop(), exhttp.ClientSettings{})
+	oldSource := StreamSource{ListenID: 17, PollAttempt: 4}
+	replacement := StreamSource{ListenID: 17, PollAttempt: 5}
+	client.listenID.Store(oldSource.ListenID)
+	client.currentSource = oldSource
+
+	reached := make(chan *StreamEvent, 1)
+	release := make(chan struct{})
+	client.SetEventHandler(func(event any) {
+		if streamEvent, ok := event.(*StreamEvent); ok {
+			reached <- streamEvent
+			<-release
+		}
+	})
+
+	readDone := make(chan bool, 1)
+	go func() {
+		readDone <- client.readLongPoll(
+			&client.Logger,
+			oldSource,
+			streamChunks(t, encryptedSettingsPayload(t, auth, "old-source")),
+			false,
+			func() {},
+		)
+	}()
+
+	streamEvent := <-reached
+	if streamEvent.Source != oldSource {
+		t.Fatalf("decoded source = %+v, want %+v", streamEvent.Source, oldSource)
+	}
+	if !client.retireStream(oldSource) {
+		t.Fatal("failed to retire old source while its callback was paused")
+	}
+	if !client.openStream(replacement) {
+		t.Fatal("failed to open same-listenID replacement poll")
+	}
+	close(release)
+	if !<-readDone {
+		t.Fatal("reader did not report the decoded event")
+	}
+	if client.retireStream(oldSource) {
+		t.Fatal("old reader retired its replacement")
+	}
+	client.listenLock.Lock()
+	current := client.currentSource
+	client.listenLock.Unlock()
+	if current != replacement {
+		t.Fatalf("current source = %+v, want replacement %+v", current, replacement)
+	}
+	wrapped, ok := streamEvent.Event.(*WrappedSettings)
+	if !ok || wrapped.Settings.GetSIMCards()[0].GetSIMParticipant().GetID() != "old-source" {
+		t.Fatalf("decoded settings event = %#v", streamEvent.Event)
+	}
+}
+
+func TestPBLiteFailureSignalsLossBeforeRetirement(t *testing.T) {
+	client := NewClient(NewAuthData(), nil, zerolog.Nop(), exhttp.ClientSettings{})
+	source := StreamSource{ListenID: 23, PollAttempt: 8}
+	client.listenID.Store(source.ListenID)
+	client.currentSource = source
+	var observed []any
+	client.SetEventHandler(func(event any) { observed = append(observed, event) })
+
+	client.readLongPoll(
+		&client.Logger,
+		source,
+		&chunkReadCloser{chunks: [][]byte{[]byte("[["), []byte(",true"), []byte("]] ")}},
+		false,
+		func() {},
+	)
+	client.retireStream(source)
+
+	if len(observed) < 2 {
+		t.Fatalf("observed %d markers, want continuity loss then retirement", len(observed))
+	}
+	lost, ok := observed[0].(*ContinuityLost)
+	if !ok || lost.Source != source || lost.Reason != "pblite_decode" {
+		t.Fatalf("first marker = %#v", observed[0])
+	}
+	retired, ok := observed[1].(*StreamRetired)
+	if !ok || retired.Source != source {
+		t.Fatalf("second marker = %#v", observed[1])
+	}
+}
+
+func TestRPCFailuresCarryFixedReasonsAndRejectStaleSource(t *testing.T) {
+	tests := []struct {
+		name   string
+		reason string
+		data   func(*testing.T, *AuthData) *gmproto.IncomingRPCMessage
+	}{
+		{
+			name:   "protobuf",
+			reason: "protobuf_decode",
+			data: func(_ *testing.T, _ *AuthData) *gmproto.IncomingRPCMessage {
+				return &gmproto.IncomingRPCMessage{BugleRoute: gmproto.BugleRoute_DataEvent, MessageData: []byte{0xff}}
+			},
+		},
+		{
+			name:   "decrypt",
+			reason: "decrypt",
+			data: func(t *testing.T, _ *AuthData) *gmproto.IncomingRPCMessage {
+				message, err := proto.Marshal(&gmproto.RPCMessageData{
+					Action:        gmproto.ActionType_GET_UPDATES,
+					EncryptedData: []byte{1},
+				})
+				if err != nil {
+					t.Fatal(err)
+				}
+				return &gmproto.IncomingRPCMessage{BugleRoute: gmproto.BugleRoute_DataEvent, MessageData: message}
+			},
+		},
+		{
+			name:   "decrypted protobuf",
+			reason: "protobuf_decode",
+			data: func(t *testing.T, auth *AuthData) *gmproto.IncomingRPCMessage {
+				encrypted, err := auth.RequestCrypto.Encrypt([]byte{0xff})
+				if err != nil {
+					t.Fatal(err)
+				}
+				message, err := proto.Marshal(&gmproto.RPCMessageData{
+					Action:        gmproto.ActionType_GET_UPDATES,
+					EncryptedData: encrypted,
+				})
+				if err != nil {
+					t.Fatal(err)
+				}
+				return &gmproto.IncomingRPCMessage{BugleRoute: gmproto.BugleRoute_DataEvent, MessageData: message}
+			},
+		},
+	}
+
+	for _, test := range tests {
+		t.Run(test.name, func(t *testing.T) {
+			auth := NewAuthData()
+			client := NewClient(auth, nil, zerolog.Nop(), exhttp.ClientSettings{})
+			source := StreamSource{ListenID: 31, PollAttempt: 1}
+			client.listenID.Store(source.ListenID)
+			client.currentSource = source
+			var losses []*ContinuityLost
+			client.SetEventHandler(func(event any) {
+				if loss, ok := event.(*ContinuityLost); ok {
+					losses = append(losses, loss)
+				}
+			})
+
+			client.HandleRPCMsgFrom(source, test.data(t, auth))
+			if len(losses) != 1 || losses[0].Source != source || losses[0].Reason != test.reason {
+				t.Fatalf("losses = %#v, want source %+v reason %q", losses, source, test.reason)
+			}
+
+			replacement := StreamSource{ListenID: source.ListenID, PollAttempt: 2}
+			client.listenLock.Lock()
+			client.currentSource = replacement
+			client.listenLock.Unlock()
+			client.HandleRPCMsgFrom(source, test.data(t, auth))
+			if len(losses) != 1 {
+				t.Fatalf("stale failure emitted %d losses, want 1", len(losses))
+			}
+		})
+	}
+}
+
+func TestAuthSnapshotSynchronizesTokenMutation(t *testing.T) {
+	auth := NewAuthData()
+	client := NewClient(auth, nil, zerolog.Nop(), exhttp.ClientSettings{})
+	start := make(chan struct{})
+	var wait sync.WaitGroup
+	wait.Add(2)
+	go func() {
+		defer wait.Done()
+		<-start
+		for index := 0; index < 1000; index++ {
+			client.updateTachyonAuthToken(&gmproto.TokenData{
+				TachyonAuthToken: []byte{byte(index), byte(index >> 8)},
+				TTL:              int64(index + 1),
+			})
+		}
+	}()
+	go func() {
+		defer wait.Done()
+		<-start
+		for index := 0; index < 1000; index++ {
+			snapshot, err := auth.Snapshot()
+			if err != nil {
+				t.Errorf("Snapshot error: %v", err)
+				return
+			}
+			if snapshot == auth {
+				t.Error("Snapshot returned producer-owned pointer")
+				return
+			}
+		}
+	}()
+	close(start)
+	wait.Wait()
+}
