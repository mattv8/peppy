+func TestPingerLoopDoesNotPingBeforeConnectionIsReady(t *testing.T) {
+	requestIDs := make(chan string, 1)
+	client := newSafetyClient(linkedSafetyAuth(), func(request *http.Request) (*http.Response, error) {
+		body, err := io.ReadAll(request.Body)
+		if err != nil {
+			return nil, err
+		}
+		var outgoing gmproto.OutgoingRPCMessage
+		if err := pblite.Unmarshal(body, &outgoing); err != nil {
+			return nil, err
+		}
+		var data gmproto.OutgoingRPCData
+		if err := proto.Unmarshal(outgoing.GetData().GetMessageData(), &data); err != nil {
+			return nil, err
+		}
+		if data.GetAction() == gmproto.ActionType_NOTIFY_DITTO_ACTIVITY {
+			requestIDs <- data.GetRequestID()
+		}
+		return successfulProtoResponse(request)
+	})
+	ownerCtx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	client.pollCtx = ownerCtx
+	client.listenID.Store(44)
+	client.currentSource = StreamSource{ListenID: 44, PollAttempt: 2}
+	succeeded := make(chan StreamSource, 1)
+	client.SetEventHandler(func(event any) {
+		streamEvent, ok := event.(*StreamEvent)
+		if ok {
+			if _, ok := streamEvent.Event.(*events.PhonePingSucceeded); ok {
+				succeeded <- streamEvent.Source
+			}
+		}
+	})
+	stop := make(chan struct{})
+	ready := make(chan struct{}, 1)
+	pinger := dittoPinger{
+		client:       client,
+		pingInterval: time.Hour,
+		stop:         stop,
+		log:          &client.Logger,
+		ctx:          ownerCtx,
+		ownerCtx:     ownerCtx,
+		listenID:     44,
+		ready:        ready,
+	}
+	loopDone := make(chan struct{})
+	go func() {
+		pinger.Loop()
+		close(loopDone)
+	}()
+	select {
+	case <-requestIDs:
+		t.Fatal("pinger sent a ditto ping before the connection was ready")
+	case <-time.After(100 * time.Millisecond):
+	}
+	ready <- struct{}{}
+	var requestID string
+	select {
+	case requestID = <-requestIDs:
+	case <-time.After(time.Second):
+		t.Fatal("ready pinger did not send a ditto ping")
+	}
+	if !client.sessionHandler.receiveResponse(&IncomingRPCMessage{
+		IncomingRPCMessage: &gmproto.IncomingRPCMessage{},
+		Source:             client.currentSource,
+		Message: &gmproto.RPCMessageData{
+			Action:    gmproto.ActionType_NOTIFY_DITTO_ACTIVITY,
+			SessionID: requestID,
+		},
+	}) {
+		t.Fatal("ready ping response was not accepted")
+	}
+	select {
+	case source := <-succeeded:
+		if source != client.currentSource {
+			t.Fatalf("ping success source = %+v, want %+v", source, client.currentSource)
+		}
+	case <-time.After(time.Second):
+		t.Fatal("ready ping did not emit PhonePingSucceeded")
+	}
+	close(stop)
+	awaitSafetySignal(t, loopDone, "pinger loop shutdown")
+}
