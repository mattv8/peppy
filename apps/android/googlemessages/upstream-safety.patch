+// queueLifecycle preserves lifecycle ordering without invoking callbacks while
+// holding listenLock. Callbacks may safely reenter Disconnect or Reconnect.
+func (c *Client) emitPingSucceeded(ownerCtx context.Context, source StreamSource) {
+	c.listenLock.Lock()
+	if ownerCtx == nil || ownerCtx.Err() != nil || c.pollCtx != ownerCtx || source == (StreamSource{}) || c.currentSource != source || c.listenID.Load() != source.ListenID || c.disconnecting.Load() {
+		c.listenLock.Unlock()
+		return
+	}
+	dispatch := c.enqueueLifecycle(&StreamEvent{Source: source, Event: &events.PhonePingSucceeded{}})
+	c.listenLock.Unlock()
+	c.dispatchLifecycle(dispatch)
+}
+
+func (c *Client) queueLifecycle(evt any) {
+	if c.enqueueLifecycle(evt) {
+		c.drainLifecycle()
+	}
+}
+
+func (c *Client) enqueueLifecycle(evt any) bool {
+	c.lifecycleMu.Lock()
+	c.lifecycleQueue = append(c.lifecycleQueue, evt)
+	if c.lifecycleActive {
+		c.lifecycleMu.Unlock()
+		return false
+	}
+	c.lifecycleActive = true
+	c.lifecycleMu.Unlock()
+	return true
+}
+
+func (c *Client) dispatchLifecycle(dispatch bool) {
+	if !dispatch {
+		return
+	}
+	if c.beforeLifecycleDrain != nil {
+		c.beforeLifecycleDrain()
+	}
+	c.drainLifecycle()
+}
+
+func (c *Client) drainLifecycle() {
+	for {
+		c.lifecycleMu.Lock()
+		if len(c.lifecycleQueue) == 0 {
+			c.lifecycleActive = false
+			c.lifecycleMu.Unlock()
+			return
+		}
+		next := c.lifecycleQueue[0]
+		c.lifecycleQueue = c.lifecycleQueue[1:]
+		c.lifecycleMu.Unlock()
+		c.triggerEvent(next)
+	}
+}
