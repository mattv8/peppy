+func TestRPCFailuresCarryFixedReasonsAndRejectStaleSource(t *testing.T) {
+	tests := []struct {
+		name   string
+		reason string
+		data   func(*testing.T, *AuthData) *gmproto.IncomingRPCMessage
+	}{
+		{
+			name:   "protobuf",
+			reason: "protobuf_decode",
+			data: func(_ *testing.T, _ *AuthData) *gmproto.IncomingRPCMessage {
+				return &gmproto.IncomingRPCMessage{BugleRoute: gmproto.BugleRoute_DataEvent, MessageData: []byte{0xff}}
+			},
+		},
+		{
+			name:   "decrypt",
+			reason: "decrypt",
+			data: func(t *testing.T, _ *AuthData) *gmproto.IncomingRPCMessage {
+				message, err := proto.Marshal(&gmproto.RPCMessageData{
+					Action:        gmproto.ActionType_GET_UPDATES,
+					EncryptedData: []byte{1},
+				})
+				if err != nil {
+					t.Fatal(err)
+				}
+				return &gmproto.IncomingRPCMessage{BugleRoute: gmproto.BugleRoute_DataEvent, MessageData: message}
+			},
+		},
+		{
+			name:   "decrypted protobuf",
+			reason: "protobuf_decode",
+			data: func(t *testing.T, auth *AuthData) *gmproto.IncomingRPCMessage {
+				encrypted, err := auth.RequestCrypto.Encrypt([]byte{0xff})
+				if err != nil {
+					t.Fatal(err)
+				}
+				message, err := proto.Marshal(&gmproto.RPCMessageData{
+					Action:        gmproto.ActionType_GET_UPDATES,
+					EncryptedData: encrypted,
+				})
+				if err != nil {
+					t.Fatal(err)
+				}
+				return &gmproto.IncomingRPCMessage{BugleRoute: gmproto.BugleRoute_DataEvent, MessageData: message}
+			},
+		},
+	}
+
+	for _, test := range tests {
+		t.Run(test.name, func(t *testing.T) {
+			auth := NewAuthData()
+			client := NewClient(auth, nil, zerolog.Nop(), exhttp.ClientSettings{})
+			source := StreamSource{ListenID: 31, PollAttempt: 1}
+			client.listenID.Store(source.ListenID)
+			client.currentSource = source
+			var losses []*ContinuityLost
+			client.SetEventHandler(func(event any) {
+				if loss, ok := event.(*ContinuityLost); ok {
+					losses = append(losses, loss)
+				}
+			})
+
+			client.HandleRPCMsgFrom(source, test.data(t, auth))
+			if len(losses) != 1 || losses[0].Source != source || losses[0].Reason != test.reason {
+				t.Fatalf("losses = %#v, want source %+v reason %q", losses, source, test.reason)
+			}
+
+			replacement := StreamSource{ListenID: source.ListenID, PollAttempt: 2}
+			client.listenLock.Lock()
+			client.currentSource = replacement
+			client.listenLock.Unlock()
+			client.HandleRPCMsgFrom(source, test.data(t, auth))
+			if len(losses) != 1 {
+				t.Fatalf("stale failure emitted %d losses, want 1", len(losses))
+			}
+		})
+	}
+}
