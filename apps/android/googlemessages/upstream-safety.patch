+type chunkReadCloser struct {
+	chunks [][]byte
+	index  int
+}
+
+func (reader *chunkReadCloser) Read(buffer []byte) (int, error) {
+	if reader.index >= len(reader.chunks) {
+		return 0, io.EOF
+	}
+	chunk := reader.chunks[reader.index]
+	reader.index++
+	return copy(buffer, chunk), nil
+}
+
+func (*chunkReadCloser) Close() error { return nil }
+
+func streamChunks(t *testing.T, payload *gmproto.LongPollingPayload) io.ReadCloser {
+	t.Helper()
+	encoded, err := pblite.Marshal(payload)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return &chunkReadCloser{chunks: [][]byte{
+		[]byte("[["),
+		append([]byte(","), encoded...),
+		[]byte("]]"),
+	}}
+}
+
+func encryptedSettingsPayload(t *testing.T, auth *AuthData, id string) *gmproto.LongPollingPayload {
+	t.Helper()
+	settings := &gmproto.Settings{SIMCards: []*gmproto.SIMCard{{
+		SIMParticipant: &gmproto.SIMParticipant{ID: id},
+	}}}
+	updates, err := proto.Marshal(&gmproto.UpdateEvents{Event: &gmproto.UpdateEvents_SettingsEvent{
+		SettingsEvent: settings,
+	}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	encrypted, err := auth.RequestCrypto.Encrypt(updates)
+	if err != nil {
+		t.Fatal(err)
+	}
+	message, err := proto.Marshal(&gmproto.RPCMessageData{
+		Action:        gmproto.ActionType_GET_UPDATES,
+		EncryptedData: encrypted,
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	return &gmproto.LongPollingPayload{Data: &gmproto.IncomingRPCMessage{
+		ResponseID:  "synthetic-response",
+		BugleRoute:  gmproto.BugleRoute_DataEvent,
+		MessageData: message,
+	}}
+}
