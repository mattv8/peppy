+func TestRPCDiagnosticObserverReportsListBoundaries(t *testing.T) {
+	client := newSafetyClient(linkedSafetyAuth(), successfulProtoResponse)
+	var mu sync.Mutex
+	var stages []RPCDiagnosticStage
+	accepted := make(chan struct{}, 2)
+	client.SetRPCDiagnosticObserver(func(stage RPCDiagnosticStage) {
+		mu.Lock()
+		stages = append(stages, stage)
+		mu.Unlock()
+		if stage == RPCDiagnosticListHTTPAccepted {
+			accepted <- struct{}{}
+		}
+	})
+
+	for range 2 {
+		done := make(chan error, 1)
+		go func() {
+			_, err := client.ListConversations(context.Background(), &gmproto.ListConversationsRequest{})
+			done <- err
+		}()
+		awaitSafetySignal(t, waitForResponseWaiter(client), "list response waiter")
+		awaitSafetySignal(t, accepted, "list HTTP acceptance")
+		client.HandleRPCMsg(&gmproto.IncomingRPCMessage{
+			BugleRoute:  gmproto.BugleRoute_DataEvent,
+			MessageData: mustRPCDiagnosticMessage(t, client, gmproto.ActionType_LIST_CONVERSATIONS, client.sessionHandler.currentWaiterID()),
