+	}
+	c.listenLock.Unlock()
+	c.dispatchLifecycle(dispatch)
+	return retired
+}
+
+func (c *Client) retireStreamLocked(source StreamSource) bool {
+	if c.currentSource != source || source == (StreamSource{}) {
+		return false
+	}
+	c.currentSource = StreamSource{}
+	return true
+}
+
+func (c *Client) continuityLost(source StreamSource, reason string) bool {
+	c.listenLock.Lock()
