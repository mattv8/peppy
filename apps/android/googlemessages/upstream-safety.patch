+func TestDisconnectRejectsLateStreamPublication(t *testing.T) {
+	client := NewClient(NewAuthData(), nil, zerolog.Nop(), exhttp.ClientSettings{})
+	client.listenID.Store(9)
+	client.Disconnect()
+	if client.openStream(context.Background(), StreamSource{ListenID: 9, PollAttempt: 1}, nil) {
+		t.Fatal("disconnect accepted a late stream publication")
+	}
+	if client.longPollingConn.Load() != nil {
+		t.Fatal("late stream publication installed a connection")
+	}
+}
