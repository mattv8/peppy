+func TestLifecycleOrderWhenDisconnectWinsBeforeOpenedCallback(t *testing.T) {
+	client := NewClient(NewAuthData(), nil, zerolog.Nop(), exhttp.ClientSettings{})
+	client.listenID.Store(21)
+	source := StreamSource{ListenID: 21, PollAttempt: 1}
+	body := io.ReadCloser(io.NopCloser(strings.NewReader("")))
+	published, release := make(chan struct{}), make(chan struct{})
+	var once sync.Once
+	client.beforeLifecycleDrain = func() { once.Do(func() { close(published); <-release }) }
+	var eventsSeen []string
+	client.SetEventHandler(func(event any) {
+		switch event.(type) {
+		case *StreamOpened:
+			eventsSeen = append(eventsSeen, "opened")
+		case *StreamRetired:
+			eventsSeen = append(eventsSeen, "retired")
+		}
+	})
+	opened := make(chan struct{})
+	go func() {
+		if !client.openStream(context.Background(), source, &body) {
+			t.Error("failed to publish stream")
+		}
+		close(opened)
+	}()
+	awaitSafetySignal(t, published, "connection publication")
+	disconnected := make(chan struct{})
+	go func() { client.Disconnect(); close(disconnected) }()
+	awaitSafetySignal(t, disconnected, "disconnect before callback")
+	close(release)
+	awaitSafetySignal(t, opened, "ordered lifecycle delivery")
+	if got := fmt.Sprint(eventsSeen); got != "[opened retired]" {
+		t.Fatalf("lifecycle order = %s", got)
+	}
+}
