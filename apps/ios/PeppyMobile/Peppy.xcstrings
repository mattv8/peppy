    "peppy.help_android_messaging_limits": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "MMS messages sync after the phone finishes downloading them and uploading encrypted copies.\n\nRCS requires a verified carrier or OEM integration and is not available in this build.\n\nAndroid can delay background sync in Doze or battery saver. Force-stopping Peppy pauses capture until you open it again. Some one-time-code texts may not reach companion apps."
          }
        }
      }
    },
    "peppy.help_android_mms_capture": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Captures MMS after your phone's messaging app downloads it."
          }
        }
      }
    },
    "peppy.help_android_mms_wifi": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Live messages and small encrypted previews may sync over mobile data. Originals and imported history wait for Wi-Fi unless you choose Sync image in a conversation. Downloads needed to send a message are not delayed. Wi-Fi means an active Wi-Fi connection, not Ethernet or unlimited cellular."
          }
        }
      }
    },
    "peppy.help_android_own_number": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Needed only so replies to group MMS threads exclude this phone."
          }
        }
      }
    },
    "peppy.help_android_notification_mirroring": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Upgrade your other Peppy clients before enabling mirroring. Notification history is retained like messages and shares the vault's 100,000-record recovery limit. Mute noisy apps to limit growth."
          }
        }
      }
    },
    "peppy.help_android_notification_mirroring_toggle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Send app notifications to your desktop. Off by default."
          }
        }
      }
    },
    "peppy.help_android_phone_read": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Best effort. Messages you read in your phone's messaging app are marked read in Peppy, including after time away. SMS always counts; MMS counts when MMS sync is on. This needs SMS sync and SMS read access. Reading an SMS in Peppy can also mark it read on your phone, which needs notification access and Android 9 or later. Peppy never marks messages unread. RCS conversations are stored privately by your messaging app and cannot be read by Peppy. When marking SMS read on your phone, Peppy skips ambiguous or unseen conversations, and pending phone attempts expire after one day."
          }
        }
      }
    },
    "peppy.help_android_notification_wifi": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "WiFi only uses the active WiFi connection. Ethernet and cellular (even unlimited plans) are not included."
          }
        }
      }
    },
    "peppy.app_name": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Peppy"
          }
        }
      }
