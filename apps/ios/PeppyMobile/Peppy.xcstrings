    "peppy.cancel": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel"
          }
        }
      }
    },
    "peppy.mirroring": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mirroring"
          }
        }
      }
    },
    "peppy.notification_mirroring_disclosure": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notification access lets Peppy read the content Android makes available, which may include verification codes or bank alerts. Mirroring is off by default. When you enable it, Peppy encrypts copies for your vault and stores them on your configured server for your authorized vault devices. Dismissing a mirrored notification on another device may also clear it on this phone while mirroring is permitted. Turning mirroring off stops new captures and remote phone clearing. Already-synced history stays in your vault."
          }
        }
      }
    },
    "peppy.phone_read_disclosure": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Peppy can keep read status in step between your phone's messaging app and Peppy.\n\nFrom your phone: when you read an SMS or downloaded MMS in your messaging app, Peppy marks that one message read in Peppy and on your other devices. This only reads the message's read flag. It does not change your phone's messages, and dismissing a notification does not count as reading. It also catches up after time away, but only for messages Peppy already captured and still shows as unread. It needs SMS sync and SMS read access, and MMS needs MMS sync. Notification access is not needed. RCS messages are kept privately by your messaging app and cannot be read by Peppy.\n\nFrom Peppy: when you read an SMS in Peppy, Peppy can ask your phone's messaging app to use its own mark-read action. This is best effort, covers SMS only, and needs notification access and Android 9 or later. It updates the messaging app's read status for the whole conversation, and a message arriving at that moment or RCS messages Peppy cannot inspect may also be marked read. It acts only when exact message-time evidence is unambiguous; time is not a guaranteed conversation identity. Notification access can see all notifications, but this path inspects only the current default messaging app. Older reads in Peppy are not sent to your phone.\n\nRead status syncs encrypted through your configured server to your authorized devices, like your other messages. Peppy never marks messages unread."
          }
        }
      }
    },
    "peppy.sms_sync": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "SMS synchronization"
          }
        }
      }
    },
    "peppy.sms_history_title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Phone message sync"
          }
        }
      }
    },
    "peppy.sms_history_description": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With SMS sync enabled, Peppy imports existing and new sent and received messages available in Android's SMS storage. They may include verification codes or bank alerts. Peppy encrypts copies for your vault and stores them on your configured server for access by your authorized vault devices. SMS access may also let Peppy read your SIM phone number and sync an encrypted copy for group MMS recipient matching, even if MMS capture is off. Carrier SMS itself is not end-to-end encrypted."
          }
        }
      }
    },
