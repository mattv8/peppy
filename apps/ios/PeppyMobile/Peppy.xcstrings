            "state": "translated",
            "value": "Some messages need reconciliation"
          }
        }
      }
    },
    "peppy.sms_history_captured_footer": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Captured messages sync when your vault connection is available."
          }
        }
      }
    },
    "peppy.sms_history_capacity_footer": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "History import is paused to keep vault recovery available. Existing messages remain on your phone."
          }
        }
      }
    },
    "peppy.sms_capture_enabled_label": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enable SMS sync"
          }
        }
      }
    },
    "peppy.sms_capture_disabled_hint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turning this off pauses new SMS capture and new sends. It does not cancel messages already handed to Android or discard pending requests and uncertain outcomes."
          }
        }
      }
    },
    "peppy.mms_capture_disclosure": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Peppy encrypts downloaded MMS, including existing history, for sync through your configured server to your authorized vault devices. This includes message content, media and group-recipient data. Using permissions already granted, Peppy may read your SIM phone number even if MMS capture is off. Peppy syncs an encrypted copy for group-recipient matching. You can enter the number manually if unavailable. Carrier MMS itself is not end-to-end encrypted."
          }
        }
      }
    },
    "peppy.wifi_only": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wi-Fi only"
          }
        }
