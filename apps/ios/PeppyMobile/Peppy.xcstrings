    "peppy.help_ios_carrier_unavailable": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS cannot capture or send carrier SMS/MMS. Use an Android phone for carrier messaging. RCS is unavailable."
          }
        }
      }
    },
    "peppy.help_ios_sms_title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "SMS and MMS"
          }
        }
      }
    },
    "peppy.help_ios_sms_unavailable": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS does not provide an SMS inbox listener. An Android phone receives and sends SMS.\n\nMMS capture requires a carrier listener not available in this iOS build."
          }
