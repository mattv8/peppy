      }
    },
    "peppy.contacts_description": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Peppy copies this phone's contacts to your vault, end-to-end encrypted. Your other devices can browse and search them. Contacts with shared numbers stay separate records."
          }
        }
      }
    },
    "peppy.contacts_start_explainer": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sync starts as soon as you allow access. Names and numbers come first, photos follow. You can stop any time."
