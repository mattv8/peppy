          }
        }
      }
    },
    "peppy.help_ios_contacts": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS decides when background updates run; it can take hours or days. Notes are not synced from iOS."
          }
