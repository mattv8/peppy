  "description": {
    "operations": {
      "create": "Save the new revision-0 compose row with the supplied text.",
      "discard": "Discard the identified draft with expectedRevision.",
      "save": "Save the identified draft with the supplied text and expectedRevision."
    },
    "placeholders": {
      "destination": "The draft or conversation that received the moved draft, according to the field containing the token."
    },
    "revisions": "Revision fields are decimal strings. expectedRevision is the operation's compare-and-swap expectation; currentRevision is the authoritative revision returned by an error.",
    "starts": {
      "absent": "An unknown draft ID with no compose row or retirement record.",
      "discarded": "A fresh recipientless compose row discarded before the operation; its ID is retained.",
      "moved": "A source draft moved to an existing destination; revision is the destination revision and text is the carried source text.",
      "new": "A fresh recipientless compose row at revision 0.",
      "present": "A recipientless compose row saved with the given text and revision.",
      "retired": "A sent draft whose cleared retired identity has been replaced by an authored save; its ID is retained."
    }
