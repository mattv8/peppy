# Copy this file beside docker-compose.yml as .env. Never commit .env.

# Required
PUBLIC_HOST=peppy.example.com
# Use one password per database role. Generate each with `openssl rand -hex 24`;
# values must use only A-Z a-z 0-9 . _ ~ -.
POSTGRES_PASSWORD=
PEPPY_RUNTIME_DB_PASSWORD=
PEPPY_MAINTENANCE_DB_PASSWORD=
S3_SECRET_KEY=

# Recommended
# A nonempty setup token must be at least 32 UTF-8 bytes. Empty lets the first
# device to finish setup claim the server; use the same value on every replica.
# PEPPY_SETUP_TOKEN=

# Optional
# Pin a version such as :0.43.0 or a digest; defaults to :latest.
# PEPPY_SERVER_IMAGE=hub.docker.visnovsky.us/library/peppy-server:0.43.0
# PEPPY_MCP_IMAGE=hub.docker.visnovsky.us/library/peppy-mcp:0.43.0
# Defaults to https://PUBLIC_HOST.
# PUBLIC_API_URL=https://peppy.example.com
# Direct reverse-proxy peers allowed to supply forwarded client addresses.
# TRUSTED_PROXY_CIDRS=192.0.2.10/32,2001:db8::10/128
# API_BIND_IP=127.0.0.1
# API_HOST_PORT=7000
# WEB_UI_ENABLED=true
# WEB_CLIENT_ACCOUNT_URL=
# MAX_UPLOAD_BYTES=64MB
# VAULT_ATTACHMENT_QUOTA_BYTES=536870912
# PEPPY_REPLAY_RETENTION_DAYS=30

# Advanced: only change before first start.
# POSTGRES_DB=peppy
# POSTGRES_USER=peppy
# PEPPY_RUNTIME_DB_USER=peppy_runtime
# PEPPY_MAINTENANCE_DB_USER=peppy_maintenance
# S3_ACCESS_KEY=peppy
# S3_BUCKET=peppy-private
# PEPPY_ENV=production
