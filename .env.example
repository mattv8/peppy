# Copy this file beside docker-compose.yml as .env. Do not commit .env.
PEPPY_ENV=production

# Set an immutable server image digest from the public release before starting.
PEPPY_SERVER_IMAGE=
POSTGRES_DB=peppy
POSTGRES_USER=peppy
# Database passwords are interpolated raw into PostgreSQL URIs. Use only
# URI-unreserved characters: A-Z a-z 0-9 . _ ~ -. Do not percent-encode them.
POSTGRES_PASSWORD=replace-with-a-long-random-postgres-password
# POSTGRES_USER is the migration/owner role. Runtime and maintenance stay
# separate; use unique long random passwords for both roles.
PEPPY_RUNTIME_DB_USER=peppy_runtime
PEPPY_RUNTIME_DB_PASSWORD=replace-with-a-long-random-runtime-password
PEPPY_MAINTENANCE_DB_USER=peppy_maintenance
PEPPY_MAINTENANCE_DB_PASSWORD=replace-with-a-long-random-maintenance-password
# S3 credentials authorize storage access; they are not storage-encryption keys.
S3_ACCESS_KEY=replace-with-a-random-access-key
S3_SECRET_KEY=replace-with-a-long-random-secret

# Public origins are deliberately distinct from Docker-internal endpoints.
PUBLIC_HOST=peppy.example.com
PUBLIC_API_URL=https://peppy.example.com
PUBLIC_ATTACHMENT_URL=https://peppy.example.com

# Optional settings.
# S3_BUCKET=peppy-private
# PEPPY_REPLAY_RETENTION_DAYS=30
# VAULT_ATTACHMENT_QUOTA_BYTES=536870912
# API_BIND_IP=127.0.0.1
# API_HOST_PORT=7000
# WEB_UI_ENABLED=true
# WEB_CLIENT_ACCOUNT_URL=
# MAX_UPLOAD_BYTES=64MB
# Retired: Caddy still reads this only to emit an upgrade warning. Serve the UI
# at PUBLIC_HOST, then remove the old hostname and DNS record.
# WEB_CLIENT_HOST=
# Set an immutable MCP worker image digest only when using compose.mcp.yml.
# PEPPY_MCP_IMAGE=
# Optional first-claim setup token. A nonempty value must be at least 32 UTF-8
# bytes and makes first claim token-protected. Leave it unset or empty to allow
# the first device that completes setup to claim the server. Never commit a real
# value or expect the server to generate or log a fallback token. Configure the
# same value on every replica. Existing unclaimed deployments become open when
# upgraded without this setting; set it before upgrading to require a token.
# PEPPY_SETUP_TOKEN=replace-with-at-least-32-random-bytes
# Optional comma-separated IP/CIDR allowlist for direct reverse-proxy peers.
# Keep this narrowly scoped and aligned with the proxy topology. When empty,
# forwarded client addresses are ignored and rate limits use the socket peer.
# TRUSTED_PROXY_CIDRS=192.0.2.10/32,2001:db8::10/128
