# Copy this file to .env for local Compose development. Do not commit .env.
PEPPY_ENV=development
POSTGRES_DB=peppy
POSTGRES_USER=peppy
POSTGRES_PASSWORD=replace-with-a-long-random-development-password
S3_ACCESS_KEY=replace-with-a-random-development-access-key
S3_SECRET_KEY=replace-with-a-long-random-development-secret
S3_BUCKET=peppy-private
PEPPY_REPLAY_RETENTION_DAYS=30
VAULT_ATTACHMENT_QUOTA_BYTES=536870912
# Public origins are deliberately distinct from Docker-internal endpoints.
PUBLIC_API_URL=http://127.0.0.1:7000
PUBLIC_ATTACHMENT_URL=http://127.0.0.1:7000
# Browser messaging is enabled at the API origin by default. Set false to opt out.
WEB_UI_ENABLED=true
# Retired: the UI now runs at https://PUBLIC_HOST/. Remove this variable and its
# separate DNS record after upgrading; Caddy only emits a compatibility warning.
WEB_CLIENT_HOST=
# Optional HTTPS account and billing site URL shown by the browser client.
WEB_CLIENT_ACCOUNT_URL=
